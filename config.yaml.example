# Myna — Voice Typing Assistant — example configuration
# Copy to: ~/.config/myna/config.yaml
# Myna uses defaults for any key not present. Section/key names below match
# the dataclasses in myna/config/settings.py exactly.

activation:
  hotkey: "ctrl+space"    # Any combo parseable by pynput
  mode: "toggle"          # "toggle" | "push_to_hold"

audio:
  device: null
  sample_rate: 16000
  chunk_duration_ms: 30
  denoise: true

vad:
  enabled: true
  aggressiveness: 2       # Silero sensitivity 0–3 (higher = more speech detected)
  speech_pad_ms: 300      # ms of trailing silence before emitting segment

inference:
  backend: "faster_whisper"   # "faster_whisper" | "parakeet"
  model: "small"               # tiny | small | medium | large-v3 (or .en variants)
  device: "auto"                # "auto" | "cpu" | "cuda"
  compute_type: "int8"
  language: "en"
  confidence_threshold: 0.40
  beam_size: 3

speaker:
  enabled: true
  voiceprint_path: "~/.config/myna/voiceprint.pt"
  threshold: 0.65         # Cosine similarity threshold 0–1

learning:
  adapt_voiceprint: true
  vocab_enabled: true
  corrections_enabled: true

injection:
  backend: "auto"         # "auto" | "ydotool" | "xdotool"
  delay_ms: 12            # xdotool/ydotool keystroke delay
  preview_before_inject: true

indicator:
  visualizer: "waveform"  # "waveform" | "blob" (double-click the overlay to toggle live)

logging:
  level: "INFO"           # DEBUG | INFO | WARNING | ERROR
  max_bytes: 5242880      # 5 MB per log file
  backup_count: 3

notifications:
  low_confidence_message: "⚠️ I couldn't hear you clearly — could you repeat that?"
  tool: "notify-send"
