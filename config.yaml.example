# Voice Assistant — example configuration
# Copy to: ~/.config/voice-assistant/config.yaml
# (Done automatically on first run if the file is absent.)

hotkey:
  toggle_listen: "ctrl+space"   # Any combo parseable by pynput

audio:
  device: null
  sample_rate: 16000
  chunk_duration_ms: 20

vad:
  enabled: true
  aggressiveness: 2       # Silero sensitivity 0–3 (higher = more speech detected)
  speech_pad_ms: 150      # ms of trailing silence before emitting segment (lower = faster)
  min_speech_ms: 300      # discard segments shorter than this (noise filter)
  live_chunk_ms: 1000     # emit rolling partial chunk every N ms; 0 = wait for silence

stt:
  mode: "realtime"        # "realtime" (live word-by-word) | "batch" (wait for silence)
  model: "small"          # accuracy model: tiny | small | medium | large-v3
  realtime_model: "tiny"  # fast model used for live word confirmation (realtime mode)
  device: "cpu"          # "auto" | "cpu" | "cuda"
  compute_type: "int8"
  language: "en"
  confidence_threshold: 0.55   # batch mode: segments below this trigger warning
  beam_size: 1            # 1 = greedy (fast); 5 = beam search (accurate)

speaker:
  enabled: true
  voiceprint_path: "~/.config/voice-assistant/voiceprint.pt"
  threshold: 0.72         # Cosine similarity threshold 0–1
  min_samples: 10          # Minimum enrollment recordings required

injection:
  delay_ms: 8            # xdotool keystroke delay
  clear_modifiers: true

tray:
  enabled: true

logging:
  level: "INFO"           # DEBUG | INFO | WARNING | ERROR
  max_bytes: 5242880      # 5 MB per log file
  backup_count: 3

notifications:
  low_confidence_message: "⚠️ I couldn't hear you clearly — could you repeat that?"
  tool: "notify-send"     # "notify-send" or "libnotify"
