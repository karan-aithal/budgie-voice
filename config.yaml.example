# Budgie — Voice Typing Assistant — example configuration
# Copy to: ~/.config/budgie-voice/config.yaml
# Budgie uses defaults for any key not present. Section/key names below match
# the dataclasses in budgie_voice/config/settings.py exactly.

activation:
  hotkey: "ctrl+space"    # Any combo parseable by pynput (used when trigger=pynput)
  evdev_hotkey: "f9"      # Same a+b format, used when trigger=evdev. evdev never grabs the
                          # key, so it also reaches the focused app: pick one apps ignore
                          # ("pause" if your keyboard has it and an app binds F9).
  command_hotkey: ""      # Command mode key (needs llm.enabled; evdev only, e.g. "f10"). Empty = off.
                          # From a desktop shortcut use the DBus method Command instead.
  mode: "toggle"          # "toggle" | "push_to_hold"
  trigger: "auto"        # "auto" | "pynput" (X11 only) | "evdev" | "dbus"
                          # auto: pynput on X11; on Wayland evdev if a keyboard in /dev/input
                          # is readable, else dbus. evdev needs the input group:
                          #   sudo usermod -aG input $USER   (then log out and in)
                          # Only the owner may toggle — prevents one press firing twice.
  debounce_ms: 350        # Drop a repeat from the same source inside this window
  pause_media: false      # pause what is playing (needs playerctl) while dictating, resume after

audio:
  devices: []             # ordered preference, first that works wins; [] = Auto (built-in mic first)
                          # e.g. ["bt:bluez_card.AA_BB_CC_DD_EE_FF", "pa:alsa_input.usb-..."]
  input_gain_pct: null    # BT mic gain 50-150 applied when a bt: device is used; null = leave alone
  sample_rate: 16000
  chunk_duration_ms: 30
  denoise: false          # noisereduce; can clip speech on 30 ms chunks. Re-enroll after changing

vad:
  enabled: true
  aggressiveness: 2       # Silero sensitivity 0–3 (higher = more speech detected)
  speech_pad_ms: 300      # ms of trailing silence before emitting segment
  pre_roll_ms: 300        # ms of audio kept from before the first speech chunk

inference:
  backend: "faster_whisper"   # "faster_whisper" | "parakeet"
  model: "small"               # tiny | small | medium | large-v3 (or .en variants)
  device: "auto"                # "auto" | "cpu" | "cuda"
  compute_type: "int8"
  language: "en"                # BCP-47 code, or "auto": Whisper detects it, Parakeet logs once and uses en
  confidence_threshold: 0.40
  beam_size: 3
  finalize_timeout_s: 15        # max wait at stop for the last turn's transcription
  min_turn_s: 15                # a pause ends a turn only after this much audio; shorter dictations transcribe in one pass

speaker:
  enabled: true
  voiceprint_path: "~/.config/budgie-voice/voiceprint.pt"
  threshold: 0.65         # Cosine similarity threshold 0–1

learning:
  adapt_voiceprint: true
  vocab_enabled: true
  corrections_enabled: true
  dictionary_path: "~/.config/budgie-voice/dictionary.txt"   # your names/jargon, one per line

postprocessing:
  strip_fillers: false          # remove um / uh / er / hmm
  spoken_edits: true            # "scratch that" deletes the sentence before it
  strip_trailing_period: false  # drop one final "." (mainly useful in profiles below)
  snippets: {}                  # spoken phrase -> text, inserted exactly as written
  # snippets:
  #   my email: "me@example.com"
  #   sign off: "Best regards,\nKaran"
  profiles: []                  # per-app overrides, X11 only. First `match` (regex on WM_CLASS) wins;
                                # other keys override the toggle of the same name.
  # profiles:
  #   - match: "terminal|konsole|alacritty|kitty|xterm"   # terminals: no capital, no final period
  #     auto_capitalize: false
  #     strip_trailing_period: true
  #   - match: "code|jetbrains|sublime|emacs|vim"          # code editors
  #     auto_capitalize: false
  #     strip_trailing_period: true

injection:
  backend: "auto"         # "auto" | "ydotool" | "xdotool"
  delay_ms: 12            # xdotool/ydotool keystroke delay
  preview_before_inject: true
  progressive: false      # Type each turn while you speak (turns close after inference.min_turn_s).
                          # Only takes effect with preview_before_inject: false AND speaker.enabled:
                          # false; otherwise it is ignored and a notification says why.

# Optional local LLM (LM Studio or Ollama). Off by default; dictation never depends on it.
# llm:
#   enabled: true
#   url: "http://127.0.0.1:1234/v1" # LM Studio; Ollama is http://127.0.0.1:11434/v1.
#                                   # Non-loopback hosts are refused unless allow_remote: true
#   model: "qwen/qwen3.5-4b"        # id from `curl <url>/models`; no default
#   timeout_s: 8                    # slow answer = original text is used
#   allow_remote: false             # true = dictated text may leave this machine
#   min_words: 8                    # polish only dictations at least this long
#   max_len_ratio: 0.5             # polish answer rejected if its length differs more than this

indicator:
  visualizer: "waveform"  # "waveform" | "blob" (double-click the overlay to toggle live)

ui:
  theme: "system"         # "system" (follow the desktop, live) | "light" | "dark"

logging:
  level: "INFO"           # DEBUG | INFO | WARNING | ERROR

notifications:
  low_confidence_message: "⚠️ I couldn't hear you clearly — could you repeat that?"
  tool: "notify-send"
