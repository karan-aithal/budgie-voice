# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Build / distribution ──────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Models (downloaded at runtime, large binaries) ────────────────────────────
models/*
!models/.gitkeep

# ── Local logs ────────────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep

# ── Secrets / generated config ────────────────────────────────────────────────
*.pt          # voiceprint tensors

# ── Editor artefacts ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
